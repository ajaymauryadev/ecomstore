[Unit]
Description=Create encrypted Smart Kirana tenant backups
OnFailure=smart-kirana-backup-status.service

[Service]
Type=oneshot
User=smart-kirana-backup
Group=smart-kirana-backup
WorkingDirectory=/opt/smart-kirana/server
EnvironmentFile=/etc/smart-kirana/backup.env
ExecStart=/usr/bin/node scripts/backup.js create
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smart-kirana-backups
TimeoutStartSec=45min
