NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/smart-kirana

JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Leave unset for direct access. Behind a proxy, list only its actual IP addresses
# or CIDRs. The ingress must sanitize X-Forwarded-For at the trust boundary.
# TRUSTED_PROXY_CIDRS=10.40.0.12/32,fd12:3456::a/128

COOKIE_SECRET=your_cookie_secret_change_in_production

# Absolute directory shared with the backup worker. Defaults to the workspace uploads directory.
# SMART_KIRANA_UPLOADS_ROOT=/var/lib/smart-kirana/uploads

# Set imagekit for cloud storage; keys stay on the server, never in VITE_*.
IMAGE_STORAGE=local
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
# Use a separate folder for each environment/database.
IMAGEKIT_FOLDER=/smart-kirana/development
