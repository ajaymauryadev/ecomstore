# Reference for deploy/free/compose.yaml. configure.sh generates private runtime
# files outside the repository; it is the preferred way to prepare that deployment.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://APP_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/smart-kirana?retryWrites=true&w=majority

# Generate three DIFFERENT values with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=GENERATE_A_NEW_VALUE
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_VALUE
COOKIE_SECRET=GENERATE_A_THIRD_VALUE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Replace with the actual frontend origin; no trailing slash or wildcard.
CORS_ORIGINS=https://YOUR_NAME.duckdns.org
# This exact proxy address applies ONLY to the supplied free Compose network.
TRUSTED_PROXY_CIDRS=172.30.22.2/32
SMART_KIRANA_UPLOADS_ROOT=/srv/smart-kirana/uploads

# Recommended cloud storage; essential on an ephemeral host such as Render Free.
IMAGE_STORAGE=imagekit
IMAGEKIT_PRIVATE_KEY=REPLACE_WITH_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_FOLDER=/smart-kirana/production
