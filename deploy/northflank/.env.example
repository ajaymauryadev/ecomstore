# Runtime variables in Northflank. Never put these values in build arguments.
NODE_ENV=production
MONGODB_URI=mongodb+srv://APP_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/smart-kirana-production?retryWrites=true&w=majority
JWT_ACCESS_SECRET=GENERATE_A_NEW_VALUE
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_VALUE
COOKIE_SECRET=GENERATE_A_THIRD_VALUE
CORS_ORIGINS=https://REPLACE_WITH_GENERATED_NORTHFLANK_HOST
IMAGE_STORAGE=imagekit
IMAGEKIT_PRIVATE_KEY=REPLACE_WITH_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_FOLDER=/smart-kirana/northflank-production
