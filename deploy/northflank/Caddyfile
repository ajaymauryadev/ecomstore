{
	admin off
	auto_https off
}

# Northflank terminates HTTPS. Expose ONLY this port through its public ingress.
:8080 {
	root * /srv/client
	encode zstd gzip

	@backend path /api /api/* /uploads /uploads/* /socket.io /socket.io/* /health /ready
	handle @backend {
		reverse_proxy 127.0.0.1:5000 {
			# Northflank overwrites this header at PUBLIC ingress. Never trust the
			# caller-supplied X-Forwarded-For chain. Internal callers are not clients.
			header_up X-Forwarded-For {http.request.header.X-Envoy-External-Address}
			header_up X-Forwarded-Proto https
			header_up -Forwarded
		}
	}

	handle /assets/* {
		@fingerprinted {
			file
			path_regexp ^/assets/.+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
		}
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
