# Build-time values for the supplied Oracle/Caddy deployment.
# Copy to .env.production only when building outside the supplied Dockerfile.
# Serve the frontend, API and Socket.IO through the same HTTPS hostname.
VITE_API_URL=/api/v1
VITE_WS_URL=
VITE_DISABLE_WEBSOCKETS=false
VITE_APP_NAME=Smart Kirana
# Never put database credentials, JWT secrets or ImageKit private keys in VITE_*.
